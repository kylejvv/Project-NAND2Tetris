// File name: projects/1/Or8Way.hdl
/**
 * 8-way Or gate: 
 * out = in[0] Or in[1] Or ... Or in[7]
 */
CHIP Or8Way {
    IN in[8];
    OUT out;

    PARTS:
        Or(a= in[0] , b= in[1] , out= Or01 );
        Or(a= in[2] , b= in[3] , out= Or23 );
        Or(a= in[4] , b= in[5] , out= Or45 );
        Or(a= in[6] , b= in[7] , out= Or67 );

        Or(a= Or01 , b= Or23 , out= r4WayOr1 );
        Or(a= Or45 , b= Or67 , out= r4WayOr2 );

        Or(a= r4WayOr1 , b= r4WayOr2 , out= out );
}
/** variables beginning with numbers not recognised
    hence 'r4Wayor#' naming convention  */